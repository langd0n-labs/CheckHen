# Hosted mode: one local origin for the app and its socket server. A Cloudflare
# Tunnel (or any reverse proxy) publishes this origin; nothing here listens publicly.
server {
    listen ${HOSTED_BIND_ADDRESS}:${HOSTED_PORT};
    server_name _;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:${SOCKET_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }

    # The demo lecture deck (static Slidev build). It shows chat only with a valid
    # projection ticket, which the dashboard adds to the link.
    location /deck/ {
        root /usr/share/nginx;
        try_files $uri $uri/ /deck/index.html;
    }

    location / {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Set, not copied: a client's own header must not decide the scheme.
        proxy_set_header X-Forwarded-Proto ${HOSTED_FORWARDED_PROTO};
    }
}
