server {
    listen ${AP_ADDRESS}:80;
    listen [${AP_IPV6_ADDRESS}]:80;
    server_name _;
    return 302 https://${AP_HOSTNAME}/join;
}

server {
    listen ${AP_ADDRESS}:443 ssl;
    listen [${AP_IPV6_ADDRESS}]:443 ssl;
    server_name ${AP_HOSTNAME};
    ssl_certificate /certs/live/${AP_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /certs/live/${AP_HOSTNAME}/privkey.pem;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:6060;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Exam heartbeats are credited to the device at this address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
