// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClassTemplate {
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  id         String   @id @default(uuid())
  name       String
  color      String   // hex, e.g. "#0066ff"
  duration   Int      // minutes per session
  daysOfWeek Int[]    // 0=Sun … 6=Sat
  startTime  String   // "HH:MM" 24h
  tz         String   @default("America/New_York")
  createdAt  DateTime @default(now())
  classes    Class[]
}

model Class {
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  events ParticipationEvent[]

  @@unique([id, courseId])
  id           String         @id @default(uuid())
  checkIns     CheckIn[]
  handRaises   HandRaise[]
  chatMessages ChatMessage[]
  paceSignals  PaceSignal[]
  name         String
  duration     Int
  color        String?        // hex color copied from template (or set ad hoc)
  templateId   String?
  template     ClassTemplate? @relation(fields: [templateId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt
}

model CheckIn {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  class         Class     @relation(fields: [classId], references: [id])
  classId       String
  socketId      String?
  anonymousName String?   // Anonymous name like "Swift Panda"
  isPresent     Boolean   @default(true)
  checkOutTime  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([classId, isPresent])
  @@index([userId, classId])
}

model HandRaise {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  class          Class     @relation(fields: [classId], references: [id])
  classId        String
  isAcknowledged Boolean   @default(false)
  isRated        Boolean   @default(false)
  hasValue       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  @@index([classId, isAcknowledged])
  @@index([userId, classId])
}

model User {
  rosterEntries RosterEntry[]
  participationEvents ParticipationEvent[]
  id                String        @id @default(uuid())
  email             String        @unique
  isAdmin           Boolean       @default(false)
  profilePicture    String?       // URL from Google OAuth
  foodAllergies     String?       // Free-text, e.g. "peanuts, dairy"
  displayName       String?       // Preferred display name
  namePronunciation String?       // e.g. "ale-EE-sha"
  pronouns          String?       // "she/her", "he/him", "they/them", or custom
  bio               String?       // Up to 280 chars — fun facts / what they look forward to
  checkIns          CheckIn[]
  handRaises        HandRaise[]
  chatMessages      ChatMessage[]
  paceSignals       PaceSignal[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?     @updatedAt
}

model ChatMessage {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  class         Class     @relation(fields: [classId], references: [id])
  classId       String
  message       String
  anonymousName String?   // Anonymous name shown to students
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([classId])
}

model PaceSignal {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  class      Class     @relation(fields: [classId], references: [id])
  classId    String
  signalType String    // "slow_down" or "ready_to_move_on"
  createdAt  DateTime  @default(now())

  @@index([classId, signalType])
}
model Course {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  classes Class[]
  templates ClassTemplate[]
  roster RosterEntry[]
}

model RosterEntry {
  courseId String
  userId String
  active Boolean @default(true)
  course Course @relation(fields: [courseId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@id([courseId, userId])
}

model ParticipationEvent {
  id String @id @default(uuid())
  courseId String
  classId String
  userId String?
  actorId String
  kind String
  payload Json
  createdAt DateTime @default(now())
  supersedesId String?
  class Class @relation(fields: [classId, courseId], references: [id, courseId])
  user User? @relation(fields: [userId], references: [id])
  supersedes ParticipationEvent? @relation("Supersession", fields: [supersedesId, courseId, classId], references: [id, courseId, classId])
  supersededBy ParticipationEvent[] @relation("Supersession")
  @@unique([id, courseId, classId])
  @@index([courseId, classId, createdAt, id])
}
