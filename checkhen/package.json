    "recharts": "2.15.4",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@eslint/js": "9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "4.4.1",
    "@storybook/nextjs": "8.5.0",
    "@storybook/react": "8.5.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.2.0",
