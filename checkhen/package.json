    "@next/bundle-analyzer": "15.1.5",
    "@prisma/client": "6.3.1",
    "@tabler/icons-react": "3.28.1",
    "lucide-react": "^0.554.0",
    "next": "patch:next@npm%3A15.1.5#~/.yarn/patches/next-npm-15.1.5-02bc58b178.patch",
    "next-auth": "4.24.11",
