# Generated locally by scripts/start.py when .env is absent.
POSTGRES_PASSWORD=
AUTH_SECRET=
# Google OAuth web client credentials; required for sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_DOMAIN=bu.edu
# Existing admin configuration: comma-separated usernames, without @domain.
ADMIN_EMAILS=
APP_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_SOCKET_URL=http://localhost:6060
# Direct development only; Compose supplies its internal DATABASE_URL.
DATABASE_URL=postgresql://checkhen:REPLACE@localhost:5432/checkhen
# Optional developer-only settings:
ALLOWED_TEST_EMAILS=
ANALYZE=false
NEXT_TELEMETRY_DISABLED=1
# PORT, HOSTNAME and NODE_ENV are supplied by the container images.

# M2 certificate provisioning (not implemented at this checkpoint).
# Store in ignored .env.cloudflare; Zone:DNS:Edit for rfkill.dev only.
CLOUDFLARE_API_TOKEN=
