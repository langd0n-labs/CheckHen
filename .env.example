# Generated locally by scripts/start.py when .env is absent.
POSTGRES_PASSWORD=
AUTH_SECRET=
# Google OAuth web client credentials; required for sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_DOMAIN=bu.edu
# Existing admin configuration: comma-separated usernames, without @domain.
ADMIN_EMAILS=
APP_BIND_ADDRESS=127.0.0.1
# Empty means the page's own origin, behind a proxy that sends /socket.io/ to the socket server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:6060
# classroom (default): behind the CheckHen access point. hosted: a regular URL, roll-call attendance, no exam mode.
CHECKHEN_MODE=classroom
# 1: demo data and persona sign-in instead of Google. Hosted mode only; never a real roster.
CHECKHEN_DEMO=0
# Exact Slidev deck origin when using the optional I6 component.
SLIDEV_ORIGIN=
# Direct development only; Compose supplies its internal DATABASE_URL.
DATABASE_URL=postgresql://checkhen:REPLACE@localhost:5432/checkhen
# Optional developer-only settings:
ANALYZE=false
NEXT_TELEMETRY_DISABLED=1
# PORT, HOSTNAME and NODE_ENV are supplied by the container images.

# M2 laptop profile. Set the interfaces and AP passphrase on x1.
AP_INTERFACE=
UPLINK_INTERFACE=
AP_SUBNET=172.16.77.0/24
AP_ADDRESS=172.16.77.1
AP_IPV6_PREFIX=fd9b:2f69:8c44::/64
AP_IPV6_ADDRESS=fd9b:2f69:8c44::1
AP_HOSTNAME=checkhen.rfkill.dev
AP_SSID=CheckHen
AP_PASSPHRASE=
AP_COUNTRY_CODE=US
AP_HW_MODE=g
AP_CHANNEL=6
# Exact sign-in hosts from one live Google-to-BU redirect trace.
PREAUTH_DOMAINS=accounts.google.com,ssl.gstatic.com
# Set to 1 only while discovering the live redirect chain; reset to 0 afterward.
PREAUTH_DISCOVERY=0
PORTAL_AGENT_URL=
PORTAL_CONTROL_SECRET=
CERT_FULLCHAIN=
CERT_PRIVKEY=

# Certbot receives BUZZ_CLOUDFLARE_DNS_TOKEN through agent-credential run.
# It is never copied into this file.
