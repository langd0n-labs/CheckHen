[Unit]
Description=CheckHen exam iptables NAT + DNS FORWARD rules
After=network.target hostapd-exam.service
Requires=hostapd-exam.service

[Service]
Type=oneshot
RemainAfterExit=yes

# --- NAT: masquerade traffic from wlan0 (AP) out through wlan1 (extenders) ---
ExecStart=/sbin/iptables -t nat -A POSTROUTING -o wlan1 -j MASQUERADE
ExecStart=/sbin/iptables -A FORWARD -i wlan1 -o wlan0 -m state --state RELATED,ESTABLISHED -j ACCEPT
ExecStart=/sbin/iptables -A FORWARD -i wlan0 -o wlan1 -j ACCEPT

# --- Defense-in-depth: drop all FORWARD traffic by default ---
# This runs AFTER the ACCEPT rules above so existing rules are evaluated first.
ExecStart=/sbin/iptables -P FORWARD DROP

# --- Allow Google OAuth IP ranges (for sign-in to work even if DNS is blocked) ---
# Ranges: 142.250.0.0/15, 172.217.0.0/16, 74.125.0.0/16
# Verify periodically at https://www.gstatic.com/ipranges/goog.json
ExecStart=/sbin/iptables -I FORWARD -d 142.250.0.0/15 -j ACCEPT
ExecStart=/sbin/iptables -I FORWARD -d 172.217.0.0/16 -j ACCEPT
ExecStart=/sbin/iptables -I FORWARD -d 74.125.0.0/16 -j ACCEPT

# --- Enable IP forwarding ---
ExecStart=/sbin/sysctl -w net.ipv4.ip_forward=1

# --- Teardown: flush rules and restore permissive policy ---
ExecStop=/sbin/iptables -t nat -D POSTROUTING -o wlan1 -j MASQUERADE
ExecStop=/sbin/iptables -D FORWARD -i wlan1 -o wlan0 -m state --state RELATED,ESTABLISHED -j ACCEPT
ExecStop=/sbin/iptables -D FORWARD -i wlan0 -o wlan1 -j ACCEPT
ExecStop=/sbin/iptables -D FORWARD -d 142.250.0.0/15 -j ACCEPT
ExecStop=/sbin/iptables -D FORWARD -d 172.217.0.0/16 -j ACCEPT
ExecStop=/sbin/iptables -D FORWARD -d 74.125.0.0/16 -j ACCEPT
ExecStop=/sbin/iptables -P FORWARD ACCEPT

[Install]
# No WantedBy — started explicitly by start-exam.sh
